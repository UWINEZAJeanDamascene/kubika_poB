# Frontend-only environment template. The API and its PostgreSQL connection are
# configured in Stock_tenancy_system; do not put database credentials in Vite.

# Add other keys here as placeholders, do NOT commit real secrets.
EXAMPLE_API_KEY=your_api_key_here
# API Configuration
# Base URL for the backend API (without trailing slash)
VITE_API_URL=https://api.techmat.rw/api
# Backward-compatible alias used by some deployments
VITE_API_BASE_URL=https://api.techmat.rw/api

# Optional: API timeout in milliseconds (default: 30000)
# VITE_API_TIMEOUT=30000

# Browser-side Phase 0 performance telemetry is best-effort and enabled by default.
# Set false only for a deliberate local/privacy opt-out.
VITE_PERFORMANCE_TELEMETRY=true
